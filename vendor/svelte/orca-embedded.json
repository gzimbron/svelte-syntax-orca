{
  "script": {
    "name": "meta.embedded.block.javascript.svelte",
    "contentName": "source.js.embedded.svelte",
    "begin": "(<)(script)(?=[\\s>])(?:[^>\"']|\"[^\"]*\"|'[^']*')*(>)",
    "beginCaptures": {
      "1": {
        "name": "punctuation.definition.tag.begin.svelte"
      },
      "2": {
        "name": "entity.name.tag.svelte"
      },
      "3": {
        "name": "punctuation.definition.tag.end.svelte"
      }
    },
    "end": "(</)(script)\\s*(>)",
    "endCaptures": {
      "1": {
        "name": "punctuation.definition.tag.begin.svelte"
      },
      "2": {
        "name": "entity.name.tag.svelte"
      },
      "3": {
        "name": "punctuation.definition.tag.end.svelte"
      }
    },
    "patterns": [
      {
        "include": "#javascript"
      }
    ]
  },
  "style": {
    "name": "meta.embedded.block.css.svelte",
    "contentName": "source.css.embedded.svelte",
    "begin": "(<)(style)(?=[\\s>])(?:[^>\"']|\"[^\"]*\"|'[^']*')*(>)",
    "beginCaptures": {
      "1": {
        "name": "punctuation.definition.tag.begin.svelte"
      },
      "2": {
        "name": "entity.name.tag.svelte"
      },
      "3": {
        "name": "punctuation.definition.tag.end.svelte"
      }
    },
    "end": "(</)(style)\\s*(>)",
    "endCaptures": {
      "1": {
        "name": "punctuation.definition.tag.begin.svelte"
      },
      "2": {
        "name": "entity.name.tag.svelte"
      },
      "3": {
        "name": "punctuation.definition.tag.end.svelte"
      }
    },
    "patterns": [
      {
        "include": "#css"
      }
    ]
  },
  "javascript": {
    "patterns": [
      {
        "include": "#block-comment"
      },
      {
        "name": "comment.line.double-slash.js.svelte",
        "begin": "//",
        "end": "$"
      },
      {
        "include": "#strings"
      },
      {
        "name": "string.quoted.template.js.svelte",
        "begin": "`",
        "end": "`",
        "patterns": [
          {
            "include": "#escape"
          }
        ]
      },
      {
        "include": "#rune"
      },
      {
        "include": "#js-keyword"
      },
      {
        "name": "constant.language.js.svelte",
        "match": "\\b(?:true|false|null|undefined|NaN|Infinity)\\b"
      },
      {
        "name": "support.type.ts.svelte",
        "match": "\\b(?:string|number|boolean|unknown|never|any|void|object|symbol|bigint)\\b"
      },
      {
        "include": "#js-number"
      },
      {
        "name": "entity.name.function.js.svelte",
        "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()"
      },
      {
        "name": "keyword.operator.js.svelte",
        "match": "[-+*/%=!<>?:&|~^]+"
      },
      {
        "name": "punctuation.section.js.svelte",
        "match": "[{}\\[\\]();,.]"
      }
    ]
  },
  "block-comment": {
    "name": "comment.block.svelte",
    "begin": "/\\*",
    "end": "\\*/"
  },
  "strings": {
    "patterns": [
      {
        "name": "string.quoted.double.svelte",
        "begin": "\"",
        "end": "\"",
        "patterns": [
          {
            "include": "#escape"
          }
        ]
      },
      {
        "name": "string.quoted.single.svelte",
        "begin": "'",
        "end": "'",
        "patterns": [
          {
            "include": "#escape"
          }
        ]
      }
    ]
  },
  "escape": {
    "name": "constant.character.escape.svelte",
    "match": "\\\\."
  },
  "js-keyword": {
    "name": "keyword.control.js.svelte",
    "match": "\\b(?:as|async|await|break|case|catch|class|const|continue|debugger|declare|default|delete|do|else|enum|export|extends|finally|for|from|function|if|implements|import|in|instanceof|interface|keyof|let|new|of|private|protected|public|readonly|return|satisfies|static|super|switch|this|throw|try|type|typeof|var|while|with|yield)\\b"
  },
  "js-number": {
    "name": "constant.numeric.js.svelte",
    "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)n?\\b"
  },
  "css": {
    "patterns": [
      {
        "include": "#block-comment"
      },
      {
        "include": "#strings"
      },
      {
        "include": "#css-property"
      },
      {
        "include": "#css-color"
      },
      {
        "include": "#css-number"
      },
      {
        "name": "keyword.control.at-rule.css.svelte",
        "match": "@[A-Za-z-]+"
      },
      {
        "name": "entity.other.attribute-name.class.css.svelte",
        "match": "[.#][A-Za-z_][\\w-]*"
      },
      {
        "name": "entity.other.attribute-name.pseudo-class.css.svelte",
        "match": ":{1,2}[A-Za-z-]+"
      },
      {
        "name": "support.function.css.svelte",
        "match": "[A-Za-z-]+(?=\\()"
      },
      {
        "name": "keyword.other.important.css.svelte",
        "match": "!important\\b"
      },
      {
        "name": "punctuation.section.css.svelte",
        "match": "[{}():;,]"
      }
    ]
  },
  "css-property": {
    "name": "support.type.property-name.css.svelte",
    "match": "(?:--[\\w-]+|[A-Za-z-]+)(?=\\s*:(?:\\s|$|[0-9#'\"-]))"
  },
  "css-color": {
    "name": "constant.other.color.rgb-value.css.svelte",
    "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b"
  },
  "css-number": {
    "name": "constant.numeric.css.svelte",
    "match": "(?:\\b[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:%|[A-Za-z]+)?"
  },
  "js-braces": {
    "name": "meta.braces.js.svelte",
    "begin": "\\{",
    "end": "\\}",
    "patterns": [
      {
        "include": "#js-braces"
      },
      {
        "include": "#javascript"
      }
    ]
  },
  "rune": {
    "name": "support.function.rune.svelte",
    "match": "\\$(?:state|derived|effect|props|bindable|inspect|host)(?:\\.(?:raw|snapshot|by|pre|tracking|pending|root|id|with|trace))?\\b"
  }
}
